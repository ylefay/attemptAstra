\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The gap as a function of $s^{\ast }$, at $s_0=6$. (a) the exact gap in units of $1/(4p)$, minimised over the temperature; an open marker means \ref {B:dim} fails. (b) the cut ratio $C_\lambda $ (solid) against the true deficit $\{4p\min _\lambda \mathrm  {Gap}\}^{-1}$ (dotted, square markers). (c) the certificate \eqref  {eq:gapfinal}, with a reference line $\propto \{s^{\ast }(2s_0+4s^{\ast })\}^{-1}$, the only way $s^{\ast }$ enters \eqref  {eq:gapfinal} once $C_\lambda $ is bounded. (d) the cut ratio $C_\lambda $ against $2^{s^{\ast }}$ (dashed), the worst case that \cref  {rem:tie} removes.}}{25}{figure.2}\protected@file@percent }
\newlabel{fig:sstar}{{2}{25}{The gap as a function of $s^{\ast }$, at $s_0=6$. (a) the exact gap in units of $1/(4p)$, minimised over the temperature; an open marker means \ref {B:dim} fails. (b) the cut ratio $C_\lambda $ (solid) against the true deficit $\{4p\min _\lambda \mathrm {Gap}\}^{-1}$ (dotted, square markers). (c) the certificate \eqref {eq:gapfinal}, with a reference line $\propto \{s^{\ast }(2s_0+4s^{\ast })\}^{-1}$, the only way $s^{\ast }$ enters \eqref {eq:gapfinal} once $C_\lambda $ is bounded. (d) the cut ratio $C_\lambda $ against $2^{s^{\ast }}$ (dashed), the worst case that \cref {rem:tie} removes}{figure.2}{}}
